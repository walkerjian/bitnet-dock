# Copy to .env and adjust as needed
# docker compose --profile cpu up   (iMac)
# docker compose --profile gpu up   (PC)

# ── CPU (iMac) ────────────────────────────────────────────────────────────────
BITNET_MODEL=BitNet-b1.58-2B-4T
BITNET_QUANT=i2_s
BITNET_MODE=server          # server | chat | benchmark
N_THREADS=8                 # tune to taste — iMac has plenty of cores
CTX_SIZE=2048
CPU_PORT=8080

# ── GPU (PC) ──────────────────────────────────────────────────────────────────
# BITNET_MODE=chat           # chat | benchmark
GPU_PORT=8081
